{
  "name": "distribuidora-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "package": "npm run build && npm run package:binary && npm run package:copy-assets",
    "package:binary": "node scripts/build-binary.js",
    "package:copy-assets": "node scripts/copy-assets.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.4.1",
    "fastify": "^5.2.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
