DATABASE_URL="file:./distribuidora.db"
PORT=3001
CORS_ORIGIN="*"

# --- Carga por base de datos (origen PostgreSQL externo, opcional) ---
# Sin VENTAS_SOURCE_URL la pestaña "Carga por base de datos" queda deshabilitada.
VENTAS_SOURCE_URL="postgresql://usuario:password@host:5432/datacenter_aj"
VENTAS_SOURCE_TABLA="datacenter_aj.dbo.vw_ventaneta"
VENTAS_SOURCE_MAX_FILAS=500000
