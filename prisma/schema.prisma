generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id          Int     @id @default(autoincrement())
  codCliente  Int?
  razonSocial String?
  ruc         String?
  ciudad      String?
  latitud     Float?
  longitud    Float?

  @@unique([codCliente, razonSocial])
}

model Vendedor {
  id          Int     @id @default(autoincrement())
  codVendedor Int?
  vendedor    String?

  @@unique([codVendedor, vendedor])
}

model Venta {
  id Int @id @default(autoincrement())
  codCompania       Int?
  compania          String?
  codDistribuidora  Int?
  distribuidora     String?
  codCliente        Int?
  razonSocial       String?
  codProducto       Int
  producto          String?
  codMarca          Int?
  marca             String?
  fecha             String
  anhoMes           Int?
  anho              Int
  mes               Int
  dia               Int
  vtaUnit           Float?
  montoIvaBrutaGua  Float?
  costoVtaGua       Float?
  montoVtaNetaGua   Float?
  codCanal          Int?
  canal             String?
  codRamo           Int?
  ramo              String?
  codVendedor       Int?
  vendedor          String?
  tipoDoc           String?
  nroDoc            String
  nroComprobante    BigInt
  codZona           Int?
  zona              String?
  codTipoProducto   Int?
  tipoProducto      String?
  precioConIva      Float?
  precioSinIva      Float?
  porcDescuento     Float?
  precioLista       Float?
  iva               Float?
  ciudad            String?
  ruc               String?
  latitud           Float?
  longitud          Float?

  /**
   * SHA-256 de todas las columnas de negocio de la fila (ver claveVenta.ts).
   * La clave única es este hash: dos filas sólo chocan si son idénticas en las
   * 41 columnas, así líneas legítimas que difieren en cualquier valor se
   * guardan aunque compartan comprobante, producto y montos.
   */
  claveHash String @default("")

  cargaId Int
  carga   Carga @relation(fields: [cargaId], references: [id])

  @@unique([claveHash], map: "Venta_clave_hash_key")
  @@index([fecha])
  @@index([fecha(sort: Desc), nroDoc(sort: Asc)])
  @@index([vendedor])
  @@index([canal])
  @@index([ciudad])
  @@index([zona])
  @@index([marca])
  @@index([razonSocial])
}

model Carga {
  id           Int      @id @default(autoincrement())
  archivo      String
  filasTotales Int
  filasNuevas  Int      @default(0)
  filasOmitidas Int     @default(0)
  filasErrores  Int     @default(0)
  estado       String   @default("procesado")
  creadoEn     DateTime @default(now())

  ventas Venta[]
}

model ChatConversation {
  id            Int      @id @default(autoincrement())
  codexThreadId String   @unique
  title         String
  selectedModel String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
